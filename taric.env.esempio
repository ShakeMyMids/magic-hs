# TARIC 2.0 - configurazione. Copia questo file in "taric.env" (stessa cartella da cui avvii il server,
# oppure nella cartella dati se usi Docker) e compila le righe che ti servono. Non mettere taric.env su GitHub.

# --- Claude (classificazione assistita) -------------------------------------------------------------
# Chiave dell'API di Anthropic: si crea nella Console (console.anthropic.com). Senza chiave il sito funziona
# ma la classificazione assistita resta spenta. L'uso dell'API si paga a consumo, a parte rispetto all'abbonamento Claude:
# nella Console imposta un limite di spesa mensile.
ANTHROPIC_API_KEY=
# Modelli usati (rapido per individuare le voci, principale per la scelta del codice)
#TARIC_MODELLO_RAPIDO=claude-haiku-5-5
#TARIC_MODELLO=claude-sonnet-5-5

# --- Indirizzo del sito -----------------------------------------------------------------------------
# L'indirizzo con cui gli utenti raggiungono il sito: serve per i link nelle email.
#TARIC_URL_PUBBLICO=https://taric.tuodominio.it
# Interfaccia e porta di ascolto (con Docker restano 0.0.0.0 e 8000)
#TARIC_HOST=127.0.0.1
#TARIC_PORTA=8000
# Reverse proxy di cui fidarsi per X-Forwarded-For/Proto (indirizzi separati da virgola)
#TARIC_PROXY_FIDATI=127.0.0.1
# Cookie solo su HTTPS: auto (secondo la connessione), si, no
#TARIC_COOKIE_SICURO=auto

# --- Posta (conferma delle registrazioni, avvisi, password dimenticata) ------------------------------
# Senza questi valori le email restano nella scheda Gestione > Posta e ogni registrazione aspetta l'approvazione.
#TARIC_SMTP_HOST=smtp.tuodominio.it
#TARIC_SMTP_PORTA=587
#TARIC_SMTP_SICUREZZA=starttls        # starttls | ssl | nessuna
#TARIC_SMTP_UTENTE=taric@tuodominio.it
#TARIC_SMTP_PASSWORD=
#TARIC_SMTP_MITTENTE=TARIC 2.0 <taric@tuodominio.it>

# --- Dati TARIC -------------------------------------------------------------------------------------
# Cartella di database, versioni dei dati e posta non inviata (con Docker: /dati, cioe' la cartella ./dati)
#TARIC_DATI=dati
# Aggiornamento automatico all'inizio di ogni mese (si, no)
#TARIC_AGGIORNAMENTO_AUTOMATICO=si
# Da dove scaricare l'estrazione mensile ({mese} = AAAA-MM)
#TARIC_FONTE_URL=https://github.com/rousseauxy/taric-opendata/releases/download/eu-{mese}/eu-taric-{mese}.zip
# Fuso orario per decidere quando inizia il mese
#TARIC_FUSO=Europe/Rome
