# MAGIC HS - configurazione. Copia questo file in "taric.env" (stessa cartella da cui avvii il server,
# oppure nella cartella dati se usi Docker) e compila le righe che ti servono. Non mettere taric.env su GitHub.

# --- Intelligenza artificiale (classificazione assistita) -------------------------------------------
# Basta UNA chiave. Senza chiave il sito funziona ma la classificazione assistita resta spenta.
#
# Google Gemini (consigliato): chiave da Google AI Studio (aistudio.google.com).
#   Senza fatturazione si usa il piano gratuito, con limiti giornalieri bassi: va bene per provare da solo.
#   Se il sito lo usano altre persone nell'UE, i termini di Google ammettono solo il servizio a pagamento
#   (fatturazione attiva sul progetto Google Cloud della chiave): costa pochi centesimi a classificazione.
GEMINI_API_KEY=
#
# Claude di Anthropic: chiave dalla Console (console.anthropic.com), a consumo.
#ANTHROPIC_API_KEY=
#
# Qualsiasi servizio compatibile OpenAI (Groq, Mistral, OpenRouter, OpenAI, Ollama sul tuo computer...):
#TARIC_IA_FORNITORE=openai
#TARIC_IA_URL=https://api.groq.com/openai/v1          # Ollama in locale: http://localhost:11434/v1 (senza chiave)
#TARIC_IA_CHIAVE=
#TARIC_IA_MODELLO=openai/gpt-oss-120b
#
# Con piu' chiavi vince Gemini, salvo TARIC_IA_FORNITORE=gemini | anthropic | openai.
# Modelli (rapido per individuare le voci, principale per scegliere il codice). Predefiniti:
#   Gemini: gemini-3.5-flash-lite e gemini-3.7-flash     Claude: claude-haiku-5-5 e claude-sonnet-5-5
#TARIC_IA_MODELLO_RAPIDO=
#TARIC_IA_MODELLO=

# --- Indirizzo del sito -----------------------------------------------------------------------------
# L'indirizzo con cui gli utenti raggiungono il sito: serve per i link nelle email.
#TARIC_URL_PUBBLICO=https://taric.tuodominio.it
# Interfaccia e porta di ascolto (con Docker restano 0.0.0.0 e 8000)
#TARIC_HOST=127.0.0.1
#TARIC_PORTA=8000
# Reverse proxy di cui fidarsi per X-Forwarded-For/Proto (indirizzi separati da virgola)
#TARIC_PROXY_FIDATI=127.0.0.1
# Cookie solo su HTTPS: auto (secondo la connessione), si, no
#TARIC_COOKIE_SICURO=auto

# --- Posta (conferma delle registrazioni, avvisi, password dimenticata) ------------------------------
# Senza questi valori le email restano nella scheda Gestione > Posta e ogni registrazione aspetta l'approvazione.
# Casella Aruba del tuo dominio: TARIC_SMTP_HOST=smtps.aruba.it, TARIC_SMTP_PORTA=465, TARIC_SMTP_SICUREZZA=ssl
#TARIC_SMTP_HOST=smtp.tuodominio.it
#TARIC_SMTP_PORTA=587
#TARIC_SMTP_SICUREZZA=starttls        # starttls | ssl | nessuna
#TARIC_SMTP_UTENTE=taric@tuodominio.it
#TARIC_SMTP_PASSWORD=
#TARIC_SMTP_MITTENTE=MAGIC HS <taric@tuodominio.it>

# --- Dati TARIC -------------------------------------------------------------------------------------
# Cartella di database, versioni dei dati e posta non inviata (con Docker: /dati, cioe' la cartella ./dati)
#TARIC_DATI=dati
# Aggiornamento automatico all'inizio di ogni mese (si, no)
#TARIC_AGGIORNAMENTO_AUTOMATICO=si
# Da dove scaricare l'estrazione mensile ({mese} = AAAA-MM)
#TARIC_FONTE_URL=https://github.com/rousseauxy/taric-opendata/releases/download/eu-{mese}/eu-taric-{mese}.zip
# Fuso orario per decidere quando inizia il mese
#TARIC_FUSO=Europe/Rome

# --- Backup ---------------------------------------------------------------------------------------
# Backup automatici giornalieri del database da tenere in dati/backup (0 = nessun backup automatico)
#TARIC_BACKUP_COPIE=14
